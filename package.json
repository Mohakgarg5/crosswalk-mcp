{
  "name": "crosswalk-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "npm run test -w crosswalk-mcp",
    "lint": "npm run lint -w crosswalk-mcp && npm run lint -w @crosswalk/web",
    "build:core": "npm run build -w crosswalk-mcp",
    "build:web": "npm run build -w @crosswalk/web",
    "dev:web": "npm run dev -w @crosswalk/web",
    "gui": "npm run build:core && npm run dev -w @crosswalk/web"
  }
}
